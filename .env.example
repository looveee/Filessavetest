# =========================================================
# AI Short-Video Platform - environment configuration
# Copy to .env and edit before running `docker-compose up`
# =========================================================

# ---- App ----
# DEBUG=true relaxes startup safety checks (dev only).
# DEBUG=false enables strict production validation:
#   - SECRET_KEY must be a strong random string (>=48 chars, no defaults)
#   - CORS_ORIGINS must be an explicit list (no '*')
#   - Unknown AI_PROVIDER -> hard fail
DEBUG=true

# ---- PostgreSQL ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=shortvideo

# ---- Auth ----
# IMPORTANT: must be a random 48+ char string in production.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=please-change-me-to-a-random-string-at-least-64-chars-long

# ---- AI provider (v0.6) ----
# mock | claude | openai | openai_compatible
#   mock              : deterministic local content, no network, no key.
#   claude            : Anthropic Messages API (needs CLAUDE_API_KEY + CLAUDE_MODEL).
#   openai            : OpenAI Chat Completions (needs OPENAI_API_KEY + OPENAI_MODEL).
#   openai_compatible : local OpenAI-compatible server (Ollama / vLLM / LM Studio).
# When DEBUG=false and AI_PROVIDER!=mock, startup HARD-FAILS if the selected
# provider's required config is missing.
AI_PROVIDER=mock

# Generic knobs — used as fallback for whichever provider is active.
AI_MODEL=
AI_BASE_URL=
AI_API_KEY=
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_TEMPERATURE=0.7
AI_MAX_OUTPUT_TOKENS=4096

# Provider-specific overrides (win over the generic AI_* knobs above).
CLAUDE_MODEL=
CLAUDE_API_KEY=
OPENAI_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Local OpenAI-compatible server. Ollama default shown; key usually not needed.
LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1
LOCAL_LLM_MODEL=

# ---- CORS ----
# Dev: "*" is fine. Production: explicit comma-separated origins.
# e.g. CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=*

# ---- Storage exposure ----
# true  -> backend mounts /storage as static (dev convenience).
# false -> /storage is NOT mounted; only auth-checked downloads via
#          /api/assets/{id}/download work. Required in production.
SERVE_STORAGE_DIRECT=true

# ---- Rate limiting (Redis-backed) ----
RATE_LIMIT_ENABLED=true
# /api/auth/login : per IP (counted on every attempt)
RL_LOGIN_IP_LIMIT=10
RL_LOGIN_IP_WINDOW=60
# /api/auth/login : per username (counted ONLY on failed attempts)
RL_LOGIN_USER_LIMIT=10
RL_LOGIN_USER_WINDOW=300
# /api/auth/register : per IP
RL_REGISTER_IP_LIMIT=10
RL_REGISTER_IP_WINDOW=3600
# /api/users/lookup : per IP (prevents username enumeration)
RL_LOOKUP_IP_LIMIT=30
RL_LOOKUP_IP_WINDOW=60
